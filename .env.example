# Copy this file to .env and adjust if needed.
PORT=3000
NODE_ENV=development

# Main database (used by `npm start`, `npm run migrate`, `npm run demo`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger

# Separate database used ONLY by `npm test` (tests TRUNCATE tables!).
# The database name must end with "_test" or the test run refuses to start.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger_test

# Max connections in the pool
DB_POOL_SIZE=10
